<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Martina Mae Trisha N. Hetil - Personal Profile</title>
<style>
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    padding: 0 90px;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
    color: #800000;
    background: white url(../image/pic4.png) repeat-y left top / 70px auto,
                url(../image/pic4.png) repeat-y right top / 70px auto;
  }

  .page {
    max-width: 700px;
    margin: 0 auto;
    padding: 24px 0 40px;
    background: white;
  }

  /* Title */
  h1 {
    text-align: center;
    font-size: 34px;
    margin: 10px 0 6px;
    letter-spacing: 1px;
  }
  h1 .star { color: #f2b705; }

  /* Centered clickable menu */
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: white;
    text-align: center;
    padding: 12px 0;
  }
  nav a {
    display: inline-block;
    margin: 4px 4px;
    padding: 6px 16px;
    font-size: 14px;
    text-decoration: none;
    color: #800000;
    background: #fff6d6;
    border: 1px solid #f2b705;
    border-radius: 20px;
    transition: background 0.2s;
  }
  nav a:hover { background: #f2b705; }

  /* Section headings */
  h2 {
    font-size: 22px;
    margin: 44px 0 12px;
    color: #800000;
  }
  h2::before {
    content: "★";
    color: #f2b705;
    margin-right: 8px;
  }

  /* About Me: text left, photo right */
  .about {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .about p { flex: 1; margin: 0; }
  .about img {
    width: 240px;
    max-width: 45%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(128, 0, 0, 0.2);
  }

  /* Education table */
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th, td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid #f3e6b3;
  }
  th { background: #fff6d6; }

  /* Lists */
  ul { padding-left: 22px; }
  li::marker { color: #f2b705; }

  /* Large cat photo */
  .cats {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 20px;
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(128, 0, 0, 0.2);
  }

  /* Goals card */
  .goals {
    background: #fffaf0;
    border-left: 4px solid #f2b705;
    padding: 14px 20px;
    border-radius: 0 8px 8px 0;
  }
  .goals p { margin: 0; }

  a { color: #800000; }
  footer { text-align: center; margin-top: 44px; font-size: 14px; }

  /* Phones: slimmer borders and stacked About Me */
  @media (max-width: 600px) {
    body {
      padding: 0 40px;
      background-size: 30px auto, 30px auto;
    }
    .about { flex-direction: column; }
    .about img { max-width: 70%; }
  }
</style>
</head>
<body>

<div class="page">

  <header id="top">
    <h1><span class="star">★</span> Personal Profile Web Page <span class="star">★</span></h1>
    <nav>
      <a href="#about">About</a>
      <a href="#education">Education</a>
      <a href="#course">Course</a>
      <a href="#hobbies">Hobbies</a>
      <a href="#goals">Goals</a>
    </nav>
  </header>

  <main>

    <section id="about">
      <h2>About Me</h2>
      <div class="about">
        <p>
          Hi! I'm Tina, a Computer Science student based in the Philippines.
          I love combining logic and creativity, whether it's solving problems in code
          or bringing ideas to life through drawing and design. I'm also a proud cat caretaker.
        </p>
        <img src="../image/pic3.png" alt="Photo of Tina">
      </div>
    </section>

    <section id="education">
      <h2>Education / Achievements</h2>
      <table>
        <thead>
          <tr><th>Level</th><th>School</th><th>Years</th></tr>
        </thead>
        <tbody>
          <tr><td>Elementary</td><td>Padre Burgos Elementary School</td><td>2013 - 2019</td></tr>
          <tr><td>Junior High School</td><td>Pasay City National High School</td><td>2019 - 2023</td></tr>
          <tr><td>Senior High School</td><td>Pasay City National High School</td><td>2023 - 2025</td></tr>
          <tr><td>College</td><td>Asia Pacific College</td><td>2025 - Present</td></tr>
        </tbody>
      </table>
    </section>

    <section id="course">
      <h2>Course</h2>
      <p>
        Bachelor of Science in Computer Science (BSCS)<br>
        First Year: 2025 &bull; Currently Second Year: 2026
      </p>
    </section>

    <section id="hobbies">
      <h2>Hobbies &amp; Interests</h2>
      <ul>
        <li>Traditional and digital drawing (ibisPaint X)</li>
        <li>Design and digital art</li>
        <li>Reading</li>
        <li>Taking care of cats</li>
      </ul>
      <img class="cats" src="../image/pic2.png" alt="My cats">
    </section>

    <section id="goals">
      <h2>Goals in Life / Dream</h2>
      <div class="goals">
        <p>
          My goals are financial and mental stability, and happiness.
          My dream is to pursue art and be able to choose the path I truly want.
        </p>
      </div>
    </section>

  </main>

  <footer>
    <a href="#top">Back to top</a> |
    <a href="https://github.com/apctinahetil">My GitHub</a>
  </footer>

</div>

</body>
</html>